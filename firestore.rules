rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /banners/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if
        request.resource.data.customerName is string &&
        request.resource.data.phone is string &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.total is number &&
        request.resource.data.deliveryCost == 0 &&
        request.resource.data.status == 'pending';

      allow update: if isAdmin() ||
        (signedIn() &&
         resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }
  }
}
